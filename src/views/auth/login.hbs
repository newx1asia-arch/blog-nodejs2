<div class="auth-page">
    <div class="container">
        <div class="auth-split" data-aos="fade-up">
            <div class="auth-split-media">
                <img src="/img/hero.png" alt="ShopVN" class="auth-split-img" onerror="this.style.display='none'">
                <div class="auth-split-overlay">
                    <h2 class="h2">Chào mừng trở lại!</h2>
                    <p>Đăng nhập để tiếp tục mua sắm thông minh cùng ShopVN.</p>
                </div>
            </div>

            <div class="auth-split-form">
                <h2 class="h2 mb-1">Đăng nhập</h2>
                <p class="auth-subtitle">Nhập thông tin tài khoản của bạn</p>

                {{#if error}}<div class="field-error">{{error}}</div>{{/if}}

                <a href="/auth/google" class="btn-google">
                    <svg width="18" height="18" viewBox="0 0 18 18" xmlns="http://www.w3.org/2000/svg">
                        <path fill="#4285F4" d="M17.64 9.2c0-.64-.06-1.25-.16-1.84H9v3.48h4.84a4.14 4.14 0 0 1-1.8 2.72v2.26h2.9c1.7-1.57 2.7-3.88 2.7-6.62z"/>
                        <path fill="#34A853" d="M9 18c2.43 0 4.47-.8 5.96-2.18l-2.9-2.26c-.8.54-1.84.86-3.06.86-2.35 0-4.34-1.59-5.05-3.72H.95v2.33A9 9 0 0 0 9 18z"/>
                        <path fill="#FBBC05" d="M3.95 10.7A5.4 5.4 0 0 1 3.68 9c0-.59.1-1.16.27-1.7V4.97H.95A9 9 0 0 0 0 9c0 1.45.35 2.83.95 4.03l3-2.33z"/>
                        <path fill="#EA4335" d="M9 3.58c1.32 0 2.5.45 3.44 1.35l2.58-2.58C13.46.9 11.43 0 9 0A9 9 0 0 0 .95 4.97l3 2.33C4.66 5.17 6.65 3.58 9 3.58z"/>
                    </svg>
                    Đăng nhập bằng Google
                </a>

                <div class="auth-divider"><span>hoặc</span></div>

                <form method="POST" action="/auth/login" class="auth-form">
                    <div class="field-group">
                        <label class="field-label">Email</label>
                        <input type="email" class="field-input" name="email" placeholder="you@example.com" required>
                    </div>
                    <div class="field-group">
                        <label class="field-label">Mật khẩu</label>
                        <input type="password" class="field-input" name="password" placeholder="••••••••" required>
                    </div>
                    <button type="submit" class="btn btn-primary w-100">Đăng nhập</button>
                </form>

                <p class="auth-switch">Chưa có tài khoản? <a href="/auth/register">Đăng ký ngay</a></p>
            </div>
        </div>
    </div>
</div>