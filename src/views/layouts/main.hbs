<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ShopVN - Cửa hàng trực tuyến</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://unpkg.com/aos@2.3.4/dist/aos.css">
    <link rel="stylesheet" href="/css/app.css">

    <link rel="shortcut icon" href="/img/favicon.ico" type="image/x-icon">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@200;300;400;500;600;700;800;900&display=swap" rel="stylesheet">

    <script>
        // Dùng chung cho mọi thẻ <img onerror="avatarFallback(this)">
        // Tránh lỗi cú pháp JS khi data-URI chứa dấu nháy đơn.
        window.AVATAR_PLACEHOLDER =
            "data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 40 40'%3E%3Crect width='40' height='40' rx='20' fill='%23CBD5E1'/%3E%3Ccircle cx='20' cy='16' r='7' fill='%23fff'/%3E%3Cpath d='M6 36c0-8 6-13 14-13s14 5 14 13' fill='%23fff'/%3E%3C/svg%3E";
        function avatarFallback(img) {
            img.onerror = null;
            img.src = window.AVATAR_PLACEHOLDER;
        }
    </script>
</head>

<body class="light-theme">

    {{> header}}

    {{{body}}}

    {{> footer}}

    {{> bottom-nav}}

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://unpkg.com/aos@2.3.4/dist/aos.js"></script>
    <script type="module" src="https://unpkg.com/ionicons@5.5.2/dist/ionicons/ionicons.esm.js"></script>
    <script nomodule src="https://unpkg.com/ionicons@5.5.2/dist/ionicons/ionicons.js"></script>

    <script>
        AOS.init({ duration: 600, once: true });

        const nav = document.querySelector('.mobile-nav');
        const navMenuBtn = document.querySelector('.nav-menu-btn');
        const navCloseBtn = document.querySelector('.nav-close-btn');
        const navToggleFunc = () => { if (nav) nav.classList.toggle('active'); };
        if (navMenuBtn) navMenuBtn.addEventListener('click', navToggleFunc);
        if (navCloseBtn) navCloseBtn.addEventListener('click', navToggleFunc);

        // ----- Highlight tab đang active trên bottom-nav -----
        document.querySelectorAll('.bottom-nav-item').forEach(item => {
            const path = item.dataset.path;
            const match = path === '/' ? location.pathname === '/' : location.pathname.startsWith(path);
            if (match) item.classList.add('active');
        });

        // ----- Dark/Light theme: ghi nhớ lựa chọn bằng localStorage -----
        const themeBtns = document.querySelectorAll('.theme-btn');

        function applyTheme(theme) {
            document.body.classList.remove('light-theme', 'dark-theme');
            document.body.classList.add(theme === 'dark' ? 'dark-theme' : 'light-theme');
            themeBtns.forEach(btn => {
                btn.classList.remove('light', 'dark');
                btn.classList.add(theme === 'dark' ? 'dark' : 'light');
            });
        }

        applyTheme(localStorage.getItem('shopvn-theme') || 'light');

        themeBtns.forEach(btn => {
            btn.addEventListener('click', () => {
                const current = document.body.classList.contains('dark-theme') ? 'dark' : 'light';
                const next = current === 'dark' ? 'light' : 'dark';
                applyTheme(next);
                localStorage.setItem('shopvn-theme', next);
            });
        });
    </script>
</body>
</html>