<aside class="account-sidebar">
    <div class="account-user-card">
        <img src="{{#if currentUser.avatar}}{{currentUser.avatar}}{{else}}/img/pattern.png{{/if}}"
             alt="{{currentUser.name}}" class="account-avatar" onerror="this.onerror=null;this.src='/img/pattern.png';">
        <div>
            <p class="account-user-name">{{currentUser.name}}</p>
            <a href="/me/profile" class="account-user-edit">Sửa hồ sơ</a>
        </div>
    </div>

    <nav class="account-nav">
        <a href="/me/profile" class="account-nav-item {{#eq active "profile"}}active{{/eq}}">
            <ion-icon name="person-outline"></ion-icon> Thông tin tài khoản
        </a>
        <a href="/me/password" class="account-nav-item {{#eq active "password"}}active{{/eq}}">
            <ion-icon name="lock-closed-outline"></ion-icon> Đổi mật khẩu
        </a>
        <a href="/me/orders" class="account-nav-item {{#eq active "orders"}}active{{/eq}}">
            <ion-icon name="receipt-outline"></ion-icon> Đơn hàng của tôi
        </a>
        <a href="/me/products" class="account-nav-item {{#eq active "products"}}active{{/eq}}">
            <ion-icon name="pricetags-outline"></ion-icon> Sản phẩm của tôi
        </a>
        <a href="/wishlist" class="account-nav-item {{#eq active "wishlist"}}active{{/eq}}">
            <ion-icon name="heart-outline"></ion-icon> Yêu thích
        </a>
        <form method="POST" action="/auth/logout">
            <button type="submit" class="account-nav-item account-nav-logout">
                <ion-icon name="log-out-outline"></ion-icon> Đăng xuất
            </button>
        </form>
    </nav>
</aside>