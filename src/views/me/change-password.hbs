<div class="account-page">
    <div class="container">
        <div class="account-grid">
            {{> account-sidebar active="password"}}

            <div class="account-content">
                <h3 class="h3 mb-3">Đổi mật khẩu</h3>

                {{#if error}}<div class="field-error">{{error}}</div>{{/if}}

                <form method="POST" action="/me/password" class="account-form" style="max-width:420px;">
                    <div class="field-group">
                        <label class="field-label">Mật khẩu hiện tại</label>
                        <input type="password" class="field-input" name="currentPassword" required>
                    </div>
                    <div class="field-group">
                        <label class="field-label">Mật khẩu mới</label>
                        <input type="password" class="field-input" name="newPassword" minlength="6" required>
                    </div>
                    <div class="field-group">
                        <label class="field-label">Xác nhận mật khẩu mới</label>
                        <input type="password" class="field-input" name="confirmPassword" minlength="6" required>
                    </div>
                    <button type="submit" class="btn btn-primary">Cập nhật mật khẩu</button>
                </form>
            </div>
        </div>
    </div>
</div>